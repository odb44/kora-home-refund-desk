# Copy to starter/.env and fill in. Never commit .env.
# Use an AWS profile OR access keys (keys are only needed if you don't use a profile).
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Any Bedrock model with tool use that your account has access to
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: absolute path to the project data directory.
# KORA_DATA_DIR=./data

# Required before enabling supervisor approval through the local HTTP API.
# Use a long random value and never commit the real token.
KORA_SUPERVISOR_TOKEN=
